add_executable(hle_capture_tests tests/hle_capture_tests.cpp)
target_link_libraries(hle_capture_tests PRIVATE awl_hle)
add_test(NAME hle_capture_tests COMMAND hle_capture_tests)
if(MSVC)
    target_compile_options(hle_capture_tests PRIVATE /W4 /fp:strict)
else()
    target_compile_options(hle_capture_tests PRIVATE -Wall -Wextra)
endif()

# Game host: links the generated whole-game library awl_recomp_gen (generated by `awl-recomp gen --full` into build/recomp-gen).
# Only configured when that output exists, like the P0 runner.
if(TARGET awl_recomp_gen)
    add_executable(awl-host src/hle/host_main.cpp)
    target_compile_definitions(awl-host PRIVATE _CRT_SECURE_NO_WARNINGS)
    target_link_libraries(awl-host PRIVATE awl_hle awl_recomp_gen)
    if(TARGET awl_gfx)   # P2: game window and DirectX 11 renderer
        target_link_libraries(awl-host PRIVATE awl_gfx)
    endif()
    if(MSVC)
        target_compile_options(awl-host PRIVATE /W4 /fp:strict)
    else()
        target_compile_options(awl-host PRIVATE -Wall -Wextra)
    endif()
endif()
